<h2>Image</h2>

<div class="row">
  <div class="col-md-9">
    <div class="card">
      <div class="card-body p-2">
        <% if @image.image.attached? %>
          <%= image_tag @image.image, class: 'd-block w-100' %>
        <% else %>
          <p class="text-muted mb-0">No image file is attached to this post.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <%= @image.user.full_name %>

    <p class="border-top mt-3 py-2">
      <% if @image.description.present? %>
        <%= @image.description %> -
      <% end %>
      <span class="text-muted"><%= time_ago_in_words @image.created_at %> ago</span>
    </p>
  </div>
</div>
